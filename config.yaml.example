# VyanaWatch Configuration
# Copy this file to config.yaml and customize as needed.
# All values can be overridden via environment variables prefixed with VYANAWATCH_
# Example: VYANAWATCH_SERVER_PORT=9090

server:
  port: 8080
  host: "0.0.0.0"
  log_level: "info"  # debug, info, warn, error

database:
  driver: "sqlite"           # "sqlite" or "postgres"
  dsn: "./data/vyanawatch.db" # SQLite file path or PostgreSQL connection string
  # For PostgreSQL:
  # driver: "postgres"
  # dsn: "host=localhost port=5432 user=vyanawatch password=secret dbname=vyanawatch sslmode=disable"

alerting:
  email:
    enabled: false
    host: "smtp.gmail.com"
    port: 587
    username: "your-email@gmail.com"
    password: ""  # Use VYANAWATCH_SMTP_PASSWORD env var instead
    from: "VyanaWatch <your-email@gmail.com>"
    to: "alerts@example.com"

  telegram:
    enabled: false
    token: ""     # Use VYANAWATCH_TELEGRAM_TOKEN env var instead
    chat_id: ""

  discord:
    enabled: false
    webhook_url: ""  # Use VYANAWATCH_DISCORD_WEBHOOK_URL env var instead

  webhook:
    enabled: false
    url: "https://n8n.example.com/webhook/uptime"
    method: "POST"
    headers: '{"Content-Type": "application/json"}'

auth:
  enabled: false
  username: "admin"
  password: ""  # Use VYANAWATCH_AUTH_PASSWORD env var instead
